APP_NAME="Opthalmic-Management-System"
APP_ENV="local"
APP_KEY=""

HTTP_URL=0.0.0.0
HTTP_PORT=8082
HTTP_ALLOWED_ORIGINS="http://localhost:3000"

DB_CONNECTION="postgres"
DB_HOST="postgres"
DB_PORT="5432"
DB_NAME="opthalm_opd"
DB_USER="postgres"
DB_PASSWORD="change-me"

# Read by docker-compose to initialize the postgres container; keep in sync
# with DB_USER/DB_PASSWORD/DB_NAME above.
POSTGRES_DB="opthalm_opd"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me"

# TOKEN — access token (short-lived JWT)
TOKEN_SECRET="replace-with-a-long-random-secret"
TOKEN_DURATION=15m

# REFRESH TOKEN — opaque, rotating, revocable (see sessions table)
REFRESH_TOKEN_DURATION=168h

# REDIS — subscription cache + rate limiter. Inside docker-compose, the app
# reaches Redis at redis:6379 (the container's internal port); this is NOT
# the same as the host-side port docker-compose.yml maps it to.
REDIS_ADDR="redis:6379"
REDIS_PASSWORD="change-me-too"
REDIS_DB=0

# SMTP — optional. Omit SMTP_HOST to use the log-only dev email sender
# (password-reset/verification codes are logged instead of emailed).
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USERNAME=""
# SMTP_PASSWORD=""
# SMTP_FROM="no-reply@example.com"

# LOG_LEVEL — debug | info (default) | warn | error
# LOG_LEVEL=info

# UPLOAD_DIR — local disk directory for uploaded assets (currently just
# payment QR codes), served back at /uploads/*. Default: ./uploads.
# Dev/single-instance only — swap for S3 or equivalent before deploying
# with multiple instances or a read-only filesystem (e.g. Lambda).
# UPLOAD_DIR="./uploads"

# MINIO — S3-compatible object store for clinical images (fundus/OCT/
# visual-field exports pulled off diagnostic devices) and consent signature
# images. Inside docker-compose the app reaches it at minio:9000 (overridden
# in docker-compose.yml); from the host (e.g. the MinIO console) it's
# localhost:9000, console at localhost:9001.
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="change-me-minio"
MINIO_USE_SSL="false"
MINIO_BUCKET="clinical-attachments"
# MINIO_PUBLIC_BASE_URL — optional. Set this to a reverse-proxy base URL
# serving the bucket publicly if you have one; otherwise the API returns
# time-limited presigned GET URLs for each file.
# MINIO_PUBLIC_BASE_URL=""
